{
  "manifest_version": 3,
  "name": "X Ambient",
  "version": "0.2.2.1",
  "description": "ホバーしたXの投稿の画像・動画から、周囲にやわらかなアンビエントライトを広げます。",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "X Ambient",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*"
      ],
      "js": [
        "src/settings.js",
        "src/ambient-core.js",
        "src/card-layout.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
